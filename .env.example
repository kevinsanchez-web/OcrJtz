# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.

# Dominio público que apunta (registro DNS A) a la IP del servidor
DOMAIN=api.tudominio.com

# Claves de acceso (mín. 32 caracteres), separadas por coma para rotarlas.
# Genera una con: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEYS=

# Debe coincidir con el dominio
ALLOWED_HOSTS=api.tudominio.com

# Opcionales (valores por defecto)
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=20
MAX_CONCURRENT_JOBS=2
RATE_LIMIT_PER_MIN=30
MAX_AUTH_FAILURES=10
ENABLE_DOCS=0

# --- Opcionales de rendimiento ---
PDF_RENDER_DPI=200              # resolución al leer PDFs escaneados (150 es más rápido, 200 lee mejor)
MAX_SECONDS_PER_IMAGE=60        # tope de reintentos de mejora por imagen/página

# --- Respaldo con modelo de lenguaje local (Ollama). Vacío = apagado ---
# Recomendado solo con GPU (Jetson): en CPU un modelo de 7B tarda ~50-100 s por página.
LLM_URL=
LLM_MODEL=qwen2.5:latest
LLM_TIMEOUT=120
